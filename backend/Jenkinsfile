pipeline {
    agent any

    environment {
        PROJECT = "/var/www/ems_HRM"
        REPO = "git@github.com:Spero-HealthCare-Innovation/ems_HRM.git"
        BRANCH = "main"
        VENV = "/var/www/ems_HRM/venv"
    }

    stages {

        stage('Prepare Project') {
            steps {
                sh '''
                set -e
                git config --global --add safe.directory "$PROJECT" || true

                if [ ! -d "$PROJECT/.git" ]; then
                    echo "Fresh clone..."
                    mkdir -p "$PROJECT"
                    git clone -b "$BRANCH" "$REPO" "$PROJECT"
                else
                    echo "Updating repository..."
                    cd "$PROJECT"
                    git config --global --add safe.directory "$PROJECT" || true
                    git fetch origin
                    git checkout "$BRANCH"
                    git merge --ff-only "origin/$BRANCH"
                fi
                '''
            }
        }

        stage('Backend Dependencies') {
            steps {
                sh '''
                set -e
                cd "$PROJECT"

                if [ ! -d "$VENV" ]; then
                    echo "Creating virtual environment..."
                    python3 -m venv "$VENV"
                fi

                test -f "$VENV/bin/activate"
                . "$VENV/bin/activate"

                python -m pip install --upgrade pip
                python -m pip install -r requirements.txt
                '''
            }
        }

        stage('Frontend Build') {
            steps {
                sh '''
                set -e
                cd "$PROJECT/frontend"

                if [ -f package-lock.json ]; then
                    npm ci
                else
                    npm install
                fi

                npm run build
                '''
            }
        }

     

        stage('Django Checks') {
            steps {
                sh '''
                set -e
                cd "$PROJECT"
                . "$VENV/bin/activate"

                python manage.py check
                python manage.py collectstatic --noinput
                '''
            }
        }


        stage('Restart Gunicorn') {
            steps {
                sh '''
                sudo /usr/bin/systemctl restart ems_hrm
                sudo /usr/bin/systemctl is-active ems_hrm
                '''
            }
        }
    }

    post {
        success {
            echo 'Deployment completed successfully.'
        }

        failure {
            echo 'Deployment failed.'
        }
    }
}